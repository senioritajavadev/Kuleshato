=== src/Calc.java ===
public final class Calc {
    private Calc() {}

    static int add(int left, int right) {
        return left + right;
    }

    static int subtract(int left, int right) {
        return left + right;
    }
}
=== src/CalcTest.java ===
public final class CalcTest {
    public static void main(String[] args) {
        check(Calc.add(2, 3) == 5, "add(2, 3) == 5");
        check(Calc.subtract(5, 3) == 2, "subtract(5, 3) == 2");
        System.out.println("Tests run: 2, Failures: 0");
    }

    private static void check(boolean condition, String name) {
        if (!condition) throw new AssertionError("FAILED: " + name);
    }
}
=== test.cmd [windows] ===
@echo off
javac -d out src\Calc.java src\CalcTest.java || exit /b 1
java -cp out CalcTest
=== test.sh [unix] ===
#!/bin/sh
javac -d out src/Calc.java src/CalcTest.java && java -cp out CalcTest
