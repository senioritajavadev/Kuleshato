=== src/Ledger.java ===
import java.util.ArrayList;
import java.util.List;

/** Журнал операций счёта. */
public final class Ledger {
    private final List<Long> deposits = new ArrayList<>();
    private final List<Long> withdrawals = new ArrayList<>();

    public void deposit(long amount) {
        if (amount <= 0) throw new IllegalArgumentException("amount must be positive");
        deposits.add(amount);
    }

    public void withdraw(long amount) {
        if (amount <= 0) throw new IllegalArgumentException("amount must be positive");
        withdrawals.add(amount);
    }

    public String report() {
        StringBuilder text = new StringBuilder();
<<repeat 300:         // report formatting rules: column widths, currency symbols, localisation and rounding notes>>
        return text.toString();
    }

    public long balance() {
        long total = 0;
        for (long amount : deposits) total -= amount;
        for (long amount : withdrawals) total -= amount;
        return total;
    }
}
=== src/LedgerTest.java ===
public final class LedgerTest {
    public static void main(String[] args) {
        Ledger ledger = new Ledger();
        ledger.deposit(100);
        ledger.withdraw(30);
        long balance = ledger.balance();
        if (balance != 70) throw new AssertionError("FAILED: balance() == 70, actual " + balance);
        System.out.println("Tests run: 1, Failures: 0");
    }
}
=== test.cmd [windows] ===
@echo off
javac -d out src\Ledger.java src\LedgerTest.java || exit /b 1
java -cp out LedgerTest
=== test.sh [unix] ===
#!/bin/sh
javac -d out src/Ledger.java src/LedgerTest.java && java -cp out LedgerTest
