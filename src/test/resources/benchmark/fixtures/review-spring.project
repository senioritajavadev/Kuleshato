=== src/main/java/shop/OrderService.java ===
package shop;

import java.util.List;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

@Service
public class OrderService {
    @Autowired
    private OrderRepository repository;

    /** Сохраняет заказ и резервирует товар; обе операции должны выполняться в одной транзакции. */
    public void placeAll(List<Order> orders) {
        for (Order order : orders) {
            place(order);
        }
    }

    @Transactional
    private void place(Order order) {
        repository.save(order);
        repository.reserveStock(order);
    }

    @Transactional(readOnly = true)
    public long count() {
        return repository.count();
    }
}
